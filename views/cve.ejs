<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= appName %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/static/favicon.png">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body data-cve-id="<%= cveId %>" data-user-id="<%= appUserId %>">
  <header class="page-header slim">
    <div class="detail-topbar">
      <a class="back-link" href="/">← Back to CVE list</a>
      <div class="header-actions">
        <% if (sharedLookerStudioUrl) { %>
          <a class="nav-button secondary" href="<%= sharedLookerStudioUrl %>" target="_blank" rel="noopener noreferrer">Looker Studio</a>
        <% } %>
        <a class="nav-button secondary" href="/watchlist">Watchlist</a>
        <div class="brand-inline">
          <img src="/static/favicon.png" alt="Optimus logo" class="brand-mark small">
          <span class="eyebrow compact-eyebrow"><%= appName %></span>
        </div>
      </div>
    </div>
    <p class="header-copy"><%= sourceNotice %></p>
  </header>

  <main class="layout detail-layout">
    <section id="cveHero" class="detail-hero panel"></section>

    <section class="detail-grid-3 detail-grid-balance">
      <div class="panel">
        <div class="section-title-row">
          <h2>Affected Software</h2>
        </div>
        <div id="productsList" class="stack"></div>
      </div>

      <div class="panel">
        <div class="section-title-row">
          <h2>References</h2>
        </div>
        <div id="referencesList" class="stack"></div>
      </div>

      <aside class="stack">
        <div class="panel">
          <h2>Related CVEs</h2>
          <div id="relatedCves" class="stack"></div>
        </div>
      </aside>
    </section>
  </main>

  <div id="actionToast" class="toast" aria-live="polite" role="status"></div>
  <script src="/static/cve.js" defer></script>
</body>
</html>
