<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= appName %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body data-user-id="<%= appUserId %>">
  <header class="page-header">
    <div>
      <p class="eyebrow"><%= appName %></p>
      <h1>Optimus - A CVE Analysis Optimizer</h1>
      <p class="header-copy"><%= sourceNotice %></p>
    </div>
  </header>

  <main class="layout">
    <section class="panel controls controls-wide">
      <input id="searchInput" type="search" placeholder="Search CVE ID, description, vendor, product, or CWE">
      <input id="productInput" type="search" placeholder="Filter software or vendor">
      <select id="severitySelect">
        <option value="">All severities</option>
      </select>
      <select id="yearSelect">
        <option value="">All years</option>
      </select>
      <select id="sortSelect">
        <option value="newest">Sort: Newest</option>
        <option value="severity">Sort: Severity</option>
        <option value="modified">Sort: Recently modified</option>
        <option value="trending">Sort: Trending</option>
      </select>
      <button id="searchButton">Apply</button>
    </section>

    <section id="overviewGrid" class="stats-grid"></section>

    <section class="split">
      <div>
        <div class="section-title-row">
          <h2>Newest CVEs</h2>
          <span id="cveCount" class="pill"></span>
        </div>
        <div id="cveGrid" class="card-grid"></div>
      </div>

      <aside class="sidebar stack">
        <div class="panel">
          <div class="section-title-row">
            <h2>Highest Severity</h2>
          </div>
          <div id="highSeverityList" class="stack"></div>
        </div>

        <div class="panel">
          <h2>Looker Studio Views</h2>
          <p class="muted compact">Connect Looker Studio directly to these PostgreSQL views:</p>
          <div class="stack tight">
            <code>looker_cve_overview</code>
            <code>looker_daily_severity</code>
            <code>looker_vendor_year</code>
          </div>
        </div>
      </aside>
    </section>
  </main>

  <script src="/static/app.js" defer></script>
</body>
</html>
