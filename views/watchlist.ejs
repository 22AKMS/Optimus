<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= appName %> - Watchlist</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="/static/favicon.png">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body data-user-id="<%= appUserId %>">
  <header class="page-header slim">
    <div class="detail-topbar">
      <a class="back-link" href="/">Back to CVE list</a>
      <div class="header-actions">
        <% if (sharedLookerStudioUrl) { %>
          <a class="nav-button secondary" href="<%= sharedLookerStudioUrl %>" target="_blank" rel="noopener noreferrer">Looker Studio</a>
        <% } %>
        <div class="brand-inline">
          <img src="/static/favicon.png" alt="Optimus logo" class="brand-mark small">
          <span class="eyebrow compact-eyebrow"><%= appName %></span>
        </div>
      </div>
    </div>
    <h1 class="watchlist-title">Watchlist</h1>
    <p class="header-copy">Tracked product activity and saved CVEs for the current demo user.</p>
  </header>

  <main class="layout detail-layout">
    <section class="section-title-row">
      <h2>Watched Product Activity</h2>
      <span id="watchedFeedCount" class="pill"></span>
    </section>
    <div id="watchedFeed" class="card-grid"></div>

    <section class="panel watched-products-panel">
      <div class="section-title-row">
        <h2>Watched Products</h2>
        <span id="watchedProductsCount" class="pill"></span>
      </div>
      <div id="watchedProductsList" class="stack"></div>
    </section>

    <section class="section-title-row">
      <h2>Saved CVEs</h2>
      <span id="watchlistCount" class="pill"></span>
    </section>
    <div id="watchlistGrid" class="card-grid"></div>
  </main>

  <div id="actionToast" class="toast" aria-live="polite" role="status"></div>
  <script src="/static/watchlist.js" defer></script>
</body>
</html>
